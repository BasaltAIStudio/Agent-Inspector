# AgentInspector Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# Database Configuration
# ============================================
# SQLite (default, no setup needed)
DATABASE_URL=sqlite:///./agentinspector.db

# PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@localhost:5432/agentinspector
# DATABASE_URL=postgresql://user:password@db.example.com:5432/agentinspector

# ============================================
# Celery / Task Queue Configuration
# ============================================
# Redis broker URL (required for async task processing)
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ============================================
# API and Security Configuration
# ============================================
# API key for accessing the backend API
# AGENTINSPECTOR_API_KEY=your_api_key_here

# CORS origins (comma-separated)
# CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# ============================================
# Model Configuration
# ============================================
# Sentence transformer model for semantic matching
# SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# LLM judge model (optional)
# JUDGE_MODEL=gpt-4o-mini

# OpenAI API key (optional, for LLM judge)
# OPENAI_API_KEY=sk-...

# ============================================
# Logging Configuration
# ============================================
# LOG_LEVEL=INFO
# LOG_LEVEL=DEBUG

# ============================================
# Scheduler Configuration
# ============================================
# Monitoring scheduler interval in seconds
# SCHEDULER_INTERVAL_SECONDS=300
